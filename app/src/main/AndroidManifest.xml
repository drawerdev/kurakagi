<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.drawerdev.kurakagi"
    android:versionCode="2"
    android:versionName="1.0.1">

    <uses-sdk
        android:minSdkVersion="7"
        android:targetSdkVersion="34" />

    <!-- 任意: SNTP 時刻補正用（完全オフライン運用時は不使用でも動作可能） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR コード読み取り用 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- スキャン成功時の触覚フィードバック -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 4.3 以前だけ: SD カードの Kurakagi フォルダへ暗号化バックアップを読み書きする。
         4.4 以降はシステムのファイル選択画面を使うので、この権限は要らない -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="18" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="18" />

    <!-- カメラ非搭載の古い小型端末やエミュレータでも起動可能にする -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Kurakagi"
        android:allowBackup="false">

        <!-- メイン画面（トークン一覧・3連コード表示・残り秒数・クイックNTP） -->
        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR スキャン画面（縦画面 Portrait スキャン対応） -->
        <activity
            android:name=".ui.ScanActivity"
            android:label="@string/title_scan_qr"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kurakagi.Fullscreen"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- 手動アカウント追加画面 -->
        <activity
            android:name=".ui.ManualAddActivity"
            android:label="@string/title_manual_add"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- トークン詳細・再バックアップ画面（QR コード再表示・シークレット確認） -->
        <activity
            android:name=".ui.TokenDetailActivity"
            android:label="@string/title_token_detail"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- 設定・時刻補正・バックアップ管理画面 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />

    </application>
</manifest>
