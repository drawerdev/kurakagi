<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 11-12 Holo themes for cleaner native Dark/Light AlertDialogs and widgets.
         Theme.Holo.Light.NoActionBar is API 13 (see values-v13), so the light theme here
         starts from Theme.Holo.Light and hides the action bar itself. -->
    <style name="Theme.Kurakagi.Dark" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.Kurakagi.Dark.Fullscreen" parent="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.Kurakagi.Light" parent="@android:style/Theme.Holo.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:textColor">@color/light_text_primary</item>
    </style>

    <style name="Theme.Kurakagi.Light.Fullscreen" parent="@android:style/Theme.Holo.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:textColor">@color/light_text_primary</item>
    </style>
</resources>
