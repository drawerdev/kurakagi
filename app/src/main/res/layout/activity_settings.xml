<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_settings_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- トップヘッダー -->
    <LinearLayout
        android:id="@+id/layout_settings_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_surface">

        <Button
            android:id="@+id/btn_settings_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_back"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginRight="12dp" />

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/v_settings_header_divider"
        android:layout_width="fill_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <ScrollView
        android:id="@+id/settings_scroll_view"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 時刻補正カード -->
            <LinearLayout
                android:id="@+id/layout_settings_time_card"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_settings_time_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_time_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_settings_time_desc"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_time_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <!-- 現在のオフセット値表示 -->
                <LinearLayout
                    android:id="@+id/layout_settings_offset_box"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_slot_box"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_settings_offset_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_current_offset_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_settings_current_offset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_offset_exact"
                        android:textColor="@color/accent_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 手動ステッパーボタン [-10s] [-1s] [+1s] [+10s] -->
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_offset_m10"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/btn_offset_minus_10"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_secondary"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_offset_m1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/btn_offset_minus_1"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_secondary"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_offset_p1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/btn_offset_plus_1"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_secondary"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_offset_p10"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/btn_offset_plus_10"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>

                <!-- リセットボタン -->
                <Button
                    android:id="@+id/btn_offset_reset"
                    android:layout_width="fill_parent"
                    android:layout_height="36dp"
                    android:text="@string/btn_offset_reset"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- NTP同期ボタン -->
                <Button
                    android:id="@+id/btn_settings_ntp"
                    android:layout_width="fill_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_settings_ntp"
                    android:textColor="@color/text_inverse"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_accent"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_settings_ntp_status"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ntp_hint"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 2. SDカードバックアップカード -->
            <LinearLayout
                android:id="@+id/layout_settings_backup_card"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_settings_backup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_settings_backup_desc"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_settings_export"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/btn_export_sd"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_settings_import"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/btn_import_sd"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary" />

            </LinearLayout>

            <!-- 3. テーマ設定カード -->
            <LinearLayout
                android:id="@+id/layout_settings_theme_card"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_settings_theme_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_settings_theme_desc"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_theme_dark"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/theme_dark_label"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_theme_light"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/theme_light_label"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary" />

            </LinearLayout>

            <!-- 4. 表示言語設定カード -->
            <LinearLayout
                android:id="@+id/layout_settings_language_card"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_settings_language_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_settings_language_desc"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_lang_auto"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/lang_auto"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_lang_en"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/lang_en"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_lang_ja"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/lang_ja"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary" />

            </LinearLayout>

            <!-- 5. 情報（APP-RULES の「情報の画面」。drawerdev のアプリで同じ順番・同じ見出し） -->
            <LinearLayout
                android:id="@+id/layout_settings_about_card"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_settings_about_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_about_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_about_app_version"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_about_by"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_by"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tv_about_tagline"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <View
                    android:id="@+id/tv_about_official_heading_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_color"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_about_official_heading"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_official_heading"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_official_site"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_official_site"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- 白い地の上に QR を置く。余白（4 マス）は画像の中に含める -->
                <ImageView
                    android:id="@+id/iv_about_official_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="center"
                    android:contentDescription="@string/about_official_site"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_about_official_warning"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_official_warning"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <View
                    android:id="@+id/tv_about_app_heading_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_color"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_about_app_heading"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_heading"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_app_promise"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_promise"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_trust_offline"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_trust_offline"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_trust_storage"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_trust_storage"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <View
                    android:id="@+id/tv_about_report_heading_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_color"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_about_report_heading"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_report_heading"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_report_desc"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_report_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_about_copy_report"
                    android:layout_width="fill_parent"
                    android:layout_height="42dp"
                    android:text="@string/about_report_copy"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_about_report_where"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_report_where"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tv_about_report_url"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_report_url"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <View
                    android:id="@+id/tv_about_other_heading_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_color"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_about_other_heading"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_other_heading"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_other_mataoto"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_other_mataoto"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_other_mataoto_lite"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_other_mataoto_lite"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_other_hauntchat"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_other_hauntchat"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <View
                    android:id="@+id/tv_about_license_heading_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_color"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_about_license_heading"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_license_heading"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_license_text"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_license_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_about_license_parts"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_license_parts"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="0dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
