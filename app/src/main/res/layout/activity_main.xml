<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_main_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- トップヘッダー -->
    <LinearLayout
        android:id="@+id/layout_main_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_surface">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:layout_marginRight="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_offset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_offset_ok"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 設定ボタン -->
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_settings"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_secondary" />
    </LinearLayout>

    <!-- 全体プログレスインジケーター（残り秒数バー） -->
    <LinearLayout
        android:id="@+id/layout_countdown_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="@color/bg_surface_alt">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_countdown_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/countdown_label"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_countdown_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_time_countdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="fill_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="30000"
            android:progress="30000"
            android:progressDrawable="@drawable/progress_bar_custom" />
    </LinearLayout>

    <!-- メインコンテンツ領域（ListView または 空表示） -->
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- トークンリスト -->
        <ListView
            android:id="@+id/lv_tokens"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:cacheColorHint="#00000000"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:clipToPadding="false" />

        <!-- 空の時のガイド表示 -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_accounts_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_accounts_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ボトムアクションバー（追加ボタン） -->
    <LinearLayout
        android:id="@+id/layout_main_bottom"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/bg_surface"
        android:gravity="center">

        <Button
            android:id="@+id/btn_main_scan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_scan_qr"
            android:textColor="@color/text_inverse"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_accent"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_main_manual"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_manual_add"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_secondary" />
    </LinearLayout>

</LinearLayout>
