<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/border_subtle" />
            <corners android:radius="4dp" />
            <padding
                android:bottom="4dp"
                android:left="10dp"
                android:right="10dp"
                android:top="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/border_subtle" />
            <corners android:radius="4dp" />
            <padding
                android:bottom="4dp"
                android:left="10dp"
                android:right="10dp"
                android:top="4dp" />
        </shape>
    </item>
</selector>
