<?xml version="1.0" encoding="utf-8"?>
<!-- 入力欄の背景。選ばれている（フォーカスがある）ときは枠を太く、アクセントの色にする（K-02 の 2-1） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_surface_alt" />
            <stroke
                android:width="2dp"
                android:color="@color/dark_border_active" />
            <corners android:radius="6dp" />
            <padding
                android:bottom="10dp"
                android:left="12dp"
                android:right="12dp"
                android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/dark_border" />
            <corners android:radius="6dp" />
            <padding
                android:bottom="10dp"
                android:left="12dp"
                android:right="12dp"
                android:top="10dp" />
        </shape>
    </item>
</selector>
