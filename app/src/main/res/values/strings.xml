    <!-- Settings Screen: About (same order and headings in every drawerdev app) -->
    <string name="settings_about_title">About</string>
    <string name="about_app_name_version_format">%1$s %2$s (%3$d)</string>
    <string name="about_by">by drawerdev</string>
    <string name="about_tagline">Apps for old Android phones</string>
    <string name="about_official_heading">Official download</string>
    <string name="about_official_site" translatable="false">drawerdev.github.io</string>
    <string name="about_official_qr_url" translatable="false">https://drawerdev.github.io/</string>
    <string name="about_official_warning">Copies from anywhere else may be fake.</string>
    <string name="about_app_heading">About this app</string>
    <string name="about_app_promise">This app does not use the network (it has no INTERNET permission). Your keys never leave this phone. No ads, no tracking.</string>
    <string name="about_trust_offline">• Codes are calculated on this phone. No internet connection is needed.</string>
    <string name="about_trust_storage">• Storage: Keys are kept in this app\'s private storage, NOT encrypted (old Android has no hardware key store). Other apps cannot read it, but a rooted or unlocked phone can. Cloud auto-backup is off. Backups are always encrypted with your password.</string>
    <string name="about_report_heading">Report a problem</string>
    <string name="about_report_desc">The error report has only the app version, the Android version and the device model. No secrets and no account names.</string>
    <string name="about_report_copy">Copy error report</string>
    <string name="about_report_copied">Copied. Paste it into a new issue.</string>
