<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default app themes (Calm Vault Slate Dark) -->
    <style name="Theme.Kurakagi" parent="Theme.Kurakagi.Dark" />

    <style name="Theme.Kurakagi.Fullscreen" parent="Theme.Kurakagi.Dark.Fullscreen" />

    <!-- Dark Theme: Calm Vault Slate (API 7+ base) -->
    <style name="Theme.Kurakagi.Dark" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.Kurakagi.Dark.Fullscreen" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>

    <!-- Light Theme: Clean Ledger Paper (API 7+ base) -->
    <style name="Theme.Kurakagi.Light" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:textColor">@color/light_text_primary</item>
    </style>

    <style name="Theme.Kurakagi.Light.Fullscreen" parent="@android:style/Theme.Light.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:textColor">@color/light_text_primary</item>
    </style>
</resources>
