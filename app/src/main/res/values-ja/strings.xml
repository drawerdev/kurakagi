    <string name="about_other_heading">ほかのアプリ</string>
    <string name="about_other_mataoto">• Mataoto — 音楽プレイヤー兼ホーム（Android 5.0 以上）</string>
    <string name="about_other_mataoto_lite">• Mataoto Lite — Mataoto の軽量版（Android 2.1 以上）</string>
    <string name="about_other_hauntchat">• HauntChat — 古い端末でも使える AI チャット（Android 2.3 以上）</string>
    <string name="about_license_heading">ライセンス</string>
